{
  "name": "Magic Hour — Product photo to video",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "When clicking ‘Test workflow’",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/magichourhq/skills/e43c205454e2b98f155cf1632cf158220c564907/examples/aurora/guided-image.png",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      },
      "id": "http-image",
      "name": "Fetch Sample Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "imageToVideo",
        "imageSource": "binary",
        "imageBinaryProperty": "data",
        "prompt": "Slow, smooth dolly in. Keep the bottle fixed and unchanged. Preserve the AURORA label, glass geometry, cap and colors. Soft rim light moves across the glass. No cuts, new objects or text changes.",
        "durationSeconds": 5,
        "externalId": "aurora-product-video",
        "waitForCompletion": true,
        "timeoutSeconds": 900,
        "options": {
          "resolution": "720p"
        }
      },
      "id": "magic-hour",
      "name": "Magic Hour",
      "type": "n8n-nodes-magichour.magicHour",
      "typeVersion": 1,
      "position": [480, 0]
    },
    {
      "parameters": {
        "url": "={{ $json.outputUrl }}",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      },
      "id": "download-video",
      "name": "Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0]
    }
  ],
  "connections": {
    "When clicking ‘Test workflow’": {
      "main": [[{ "node": "Fetch Sample Image", "type": "main", "index": 0 }]]
    },
    "Fetch Sample Image": {
      "main": [[{ "node": "Magic Hour", "type": "main", "index": 0 }]]
    },
    "Magic Hour": {
      "main": [[{ "node": "Download Video", "type": "main", "index": 0 }]]
    }
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
